  197             | tBYVAL Identifier EmptyBrackets_opt

  198 MemberIdentifier: tIdentifier
  199                 | tERROR
  200                 | tEXPLICIT
  201                 | tSTEP

  202 Identifier: tIdentifier
  203           | tDEFAULT
  204           | tERROR
  205           | tEXPLICIT
  206           | tPROPERTY
  207           | tSTEP

  208 StSep_opt: ε
  209          | StSep

  210 Nl_opt: ε
  211       | tNL Nl_opt

  212 StSep: tNL
  213      | ':'
  214      | tNL StSep
  215      | ':' StSep


