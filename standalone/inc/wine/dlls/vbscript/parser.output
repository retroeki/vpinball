    5 SourceElements: ε
    6               | SourceElements GlobalDimDeclaration StSep
    7               | SourceElements StatementNl
    8               | SourceElements ClassDeclaration

    9 GlobalDimDeclaration: tPRIVATE tCONST ConstDeclList
   10                     | tPUBLIC tCONST ConstDeclList
