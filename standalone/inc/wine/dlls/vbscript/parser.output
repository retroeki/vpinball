   22 StatementNl: Statement tNL

   23 Statement: ':'
   24          | ':' Statement
   25          | SimpleStatement
   26          | SimpleStatement ':' Statement
   27          | SimpleStatement ':'

   28 SimpleStatement: CallExpression ArgumentList_opt
