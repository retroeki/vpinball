   45                | tSTOP
   46                | tON tERROR tRESUME tNEXT
   47                | tON tERROR tGOTO '0'
   48                | tCONST ConstDeclList
   49                | tFOR Identifier '=' Expression tTO Expression Step_opt StSep StatementsNl_opt tNEXT
   50                | tFOR tEACH Identifier tIN Expression StSep StatementsNl_opt tNEXT
   51                | tSELECT tCASE Expression StSep CaseClausules tEND tSELECT
   52                | tWITH Expression StSep StatementsNl_opt tEND tWITH

   53 MemberExpression: Identifier
   54                 | CallExpression '.' tIdentifier
   55                 | tDOT tIdentifier

   56 Preserve_opt: ε
   57             | tPRESERVE

   58 MemberDeclList: MemberDecl
   59               | MemberDecl ',' MemberDeclList

   60 MemberDecl: MemberIdentifier
   61           | MemberIdentifier '(' DimList ')'
   62           | MemberIdentifier tEMPTYBRACKETS

   63 ReDimDecl: tIdentifier '(' ArgumentList ')'

   64 ReDimDeclList: ReDimDecl
   65              | ReDimDecl ',' ReDimDeclList

   66 DimDeclList: DimDecl
   67            | DimDecl ',' DimDeclList

   68 DimDecl: Identifier
   69        | Identifier '(' DimList ')'
   70        | Identifier tEMPTYBRACKETS

   71 DimList: IntegerValue
   72        | IntegerValue ',' DimList

   73 ConstDeclList: ConstDecl
   74              | ConstDecl ',' ConstDeclList

   75 ConstDecl: Identifier '=' ConstExpression

   76 ConstExpression: LiteralExpression
   77                | '-' NumericLiteralExpression

   78 DoType: tWHILE
   79       | tUNTIL

   80 Step_opt: ε
   81         | tSTEP Expression

   82 IfStatement: tIF Expression tTHEN tNL StatementsNl_opt ElseIfs_opt Else_opt tEND tIF
   83            | tIF Expression tTHEN Statement EndIf_opt
   84            | tIF Expression tTHEN Statement tELSE Statement EndIf_opt
   85            | tIF Expression tTHEN SimpleStatement tELSE Statement EndIf_opt

   86 EndIf_opt: ε
   87          | tEND tIF

   88 ElseIfs_opt: ε
   89            | ElseIfs

   90 ElseIfs: ElseIf
   91        | ElseIf ElseIfs

   92 ElseIf: tELSEIF Expression tTHEN StSep_opt StatementsNl_opt

   93 Else_opt: ε
   94         | tELSE StSep_opt StatementsNl_opt

   95 CaseClausules: ε
   96              | tCASE tELSE StSep_opt StatementsNl_opt
   97              | tCASE ExpressionList StSep_opt StatementsNl_opt CaseClausules

   98 Arguments: tEMPTYBRACKETS
   99          | '(' ArgumentList ')'

  100 ArgumentList_opt: ε
  101                 | ArgumentList

  102 ArgumentList: Expression
  103             | Expression ',' ArgumentList
  104             | ',' ArgumentList

  105 EmptyBrackets_opt: ε
  106                  | tEMPTYBRACKETS

  107 ExpressionList: Expression
  108               | Expression ',' ExpressionList

  109 Expression: EqvExpression
  110           | Expression tIMP EqvExpression

  111 EqvExpression: XorExpression
  112              | EqvExpression tEQV XorExpression

  113 XorExpression: OrExpression
  114              | XorExpression tXOR OrExpression

  115 OrExpression: AndExpression
  116             | OrExpression tOR AndExpression

  117 AndExpression: NotExpression
  118              | AndExpression tAND NotExpression

  119 NotExpression: EqualityExpression
  120              | tNOT NotExpression

  121 EqualityExpression: ConcatExpression
  122                   | EqualityExpression '=' ConcatExpression
  123                   | EqualityExpression tNEQ ConcatExpression
  124                   | EqualityExpression '>' ConcatExpression
  125                   | EqualityExpression '<' ConcatExpression
  126                   | EqualityExpression tGTEQ ConcatExpression
  127                   | EqualityExpression tLTEQ ConcatExpression
  128                   | EqualityExpression tIS ConcatExpression

  129 ConcatExpression: AdditiveExpression
  130                 | ConcatExpression '&' AdditiveExpression

  131 AdditiveExpression: ModExpression
  132                   | AdditiveExpression '+' ModExpression
  133                   | AdditiveExpression '-' ModExpression

  134 ModExpression: IntdivExpression
  135              | ModExpression tMOD IntdivExpression

  136 IntdivExpression: MultiplicativeExpression
  137                 | IntdivExpression '\\' MultiplicativeExpression

  138 MultiplicativeExpression: ExpExpression
  139                         | MultiplicativeExpression '*' ExpExpression
  140                         | MultiplicativeExpression '/' ExpExpression

  141 ExpExpression: SignExpression
  142              | ExpExpression '^' SignExpression

  143 SignExpression: UnaryExpression
  144               | '-' SignExpression
  145               | '+' SignExpression

  146 UnaryExpression: LiteralExpression
  147                | CallExpression
  148                | tNEW Identifier

  149 CallExpression: PrimaryExpression
  150               | MemberExpression
  151               | CallExpression Arguments

  152 LiteralExpression: tTRUE
  153                  | tFALSE
  154                  | tString
  155                  | tDate
  156                  | NumericLiteralExpression
  157                  | tEMPTY
  158                  | tNULL
  159                  | tNOTHING

  160 NumericLiteralExpression: '0'
  161                         | tInt
  162                         | tDouble

  163 IntegerValue: '0'
  164             | tInt

  165 PrimaryExpression: tEXPRLBRACKET Expression ')'
  166                  | tME

  167 ClassDeclaration: tCLASS Identifier StSep ClassBody tEND tCLASS StSep

  168 ClassBody: ε
  169          | FunctionDecl
  170          | FunctionDecl StSep ClassBody
  171          | Storage MemberDeclList
  172          | Storage MemberDeclList StSep ClassBody
  173          | tDIM DimDeclList
  174          | tDIM DimDeclList StSep ClassBody
  175          | PropertyDecl
  176          | PropertyDecl StSep ClassBody

  177 PropertyDecl: Storage_opt tPROPERTY tGET Identifier ArgumentsDecl_opt StSep BodyStatements tEND tPROPERTY
  178             | Storage_opt tPROPERTY tLET Identifier '(' ArgumentDeclList ')' StSep BodyStatements tEND tPROPERTY
  179             | Storage_opt tPROPERTY tSET Identifier '(' ArgumentDeclList ')' StSep BodyStatements tEND tPROPERTY

  180 FunctionDecl: Storage_opt tSUB Identifier StSep BodyStatements tEND tSUB
  181             | Storage_opt tSUB Identifier ArgumentsDecl Nl_opt BodyStatements tEND tSUB
  182             | Storage_opt tFUNCTION Identifier StSep BodyStatements tEND tFUNCTION
  183             | Storage_opt tFUNCTION Identifier ArgumentsDecl Nl_opt BodyStatements tEND tFUNCTION

  184 Storage_opt: ε
  185            | Storage

  186 Storage: tPUBLIC tDEFAULT
  187        | tPUBLIC
  188        | tPRIVATE

  189 ArgumentsDecl_opt: ε
  190                  | ArgumentsDecl

  191 ArgumentsDecl: tEMPTYBRACKETS
  192              | '(' ArgumentDeclList ')'

  193 ArgumentDeclList: ArgumentDecl
  194                 | ArgumentDecl ',' ArgumentDeclList

  195 ArgumentDecl: Identifier EmptyBrackets_opt
