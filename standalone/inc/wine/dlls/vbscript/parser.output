   12                     | tPUBLIC DimDeclList

   13 ExpressionNl_opt: ε
   14                 | Expression tNL

   15 BodyStatements: ε
   16               | Statement
   17               | StatementNl BodyStatements

   18 StatementsNl_opt: ε
   19                 | StatementsNl

   20 StatementsNl: SimpleStatement StSep
   21             | SimpleStatement StSep StatementsNl

   22 StatementNl: Statement tNL

   23 Statement: ':'
   24          | ':' Statement
   25          | SimpleStatement
   26          | SimpleStatement ':' Statement
   27          | SimpleStatement ':'

   28 SimpleStatement: CallExpression ArgumentList_opt
   29                | tCALL UnaryExpression
   30                | CallExpression '=' Expression
   31                | tDIM DimDeclList
   32                | tREDIM Preserve_opt ReDimDeclList
   33                | IfStatement
   34                | tWHILE Expression StSep StatementsNl_opt tWEND
   35                | tDO DoType Expression StSep StatementsNl_opt tLOOP
   36                | tDO StSep StatementsNl_opt tLOOP DoType Expression
   37                | tDO StSep StatementsNl_opt tLOOP
   38                | FunctionDecl
   39                | tEXIT tDO
   40                | tEXIT tFOR
   41                | tEXIT tFUNCTION
   42                | tEXIT tPROPERTY
   43                | tEXIT tSUB
   44                | tSET CallExpression '=' Expression
   45                | tSTOP
   46                | tON tERROR tRESUME tNEXT
   47                | tON tERROR tGOTO '0'
   48                | tCONST ConstDeclList
   49                | tFOR Identifier '=' Expression tTO Expression Step_opt StSep StatementsNl_opt tNEXT
   50                | tFOR tEACH Identifier tIN Expression StSep StatementsNl_opt tNEXT
   51                | tSELECT tCASE Expression StSep CaseClausules tEND tSELECT
   52                | tWITH Expression StSep StatementsNl_opt tEND tWITH

   53 MemberExpression: Identifier
   54                 | CallExpression '.' tIdentifier
   55                 | tDOT tIdentifier

   56 Preserve_opt: ε
   57             | tPRESERVE

   58 MemberDeclList: MemberDecl
   59               | MemberDecl ',' MemberDeclList

   60 MemberDecl: MemberIdentifier
   61           | MemberIdentifier '(' DimList ')'
   62           | MemberIdentifier tEMPTYBRACKETS

   63 ReDimDecl: tIdentifier '(' ArgumentList ')'

   64 ReDimDeclList: ReDimDecl
   65              | ReDimDecl ',' ReDimDeclList

   66 DimDeclList: DimDecl
   67            | DimDecl ',' DimDeclList

   68 DimDecl: Identifier
   69        | Identifier '(' DimList ')'
   70        | Identifier tEMPTYBRACKETS

   71 DimList: IntegerValue
   72        | IntegerValue ',' DimList

   73 ConstDeclList: ConstDecl
   74              | ConstDecl ',' ConstDeclList

   75 ConstDecl: Identifier '=' ConstExpression

   76 ConstExpression: LiteralExpression
   77                | '-' NumericLiteralExpression

   78 DoType: tWHILE
   79       | tUNTIL

   80 Step_opt: ε
   81         | tSTEP Expression

   82 IfStatement: tIF Expression tTHEN tNL StatementsNl_opt ElseIfs_opt Else_opt tEND tIF
   83            | tIF Expression tTHEN Statement EndIf_opt
   84            | tIF Expression tTHEN Statement tELSE Statement EndIf_opt

   85 EndIf_opt: ε
   86          | tEND tIF

   87 ElseIfs_opt: ε
   88            | ElseIfs

   89 ElseIfs: ElseIf
   90        | ElseIf ElseIfs

   91 ElseIf: tELSEIF Expression tTHEN StSep_opt StatementsNl_opt

   92 Else_opt: ε
   93         | tELSE StSep_opt StatementsNl_opt

   94 CaseClausules: ε
   95              | tCASE tELSE StSep_opt StatementsNl_opt
   96              | tCASE ExpressionList StSep_opt StatementsNl_opt CaseClausules

   97 Arguments: tEMPTYBRACKETS
   98          | '(' ArgumentList ')'

   99 ArgumentList_opt: ε
  100                 | ArgumentList

  101 ArgumentList: Expression
  102             | Expression ',' ArgumentList
  103             | ',' ArgumentList

  104 EmptyBrackets_opt: ε
  105                  | tEMPTYBRACKETS

  106 ExpressionList: Expression
  107               | Expression ',' ExpressionList

  108 Expression: EqvExpression
  109           | Expression tIMP EqvExpression

  110 EqvExpression: XorExpression
  111              | EqvExpression tEQV XorExpression

  112 XorExpression: OrExpression
  113              | XorExpression tXOR OrExpression

  114 OrExpression: AndExpression
  115             | OrExpression tOR AndExpression

  116 AndExpression: NotExpression
  117              | AndExpression tAND NotExpression

  118 NotExpression: EqualityExpression
  119              | tNOT NotExpression

  120 EqualityExpression: ConcatExpression
  121                   | EqualityExpression '=' ConcatExpression
  122                   | EqualityExpression tNEQ ConcatExpression
  123                   | EqualityExpression '>' ConcatExpression
  124                   | EqualityExpression '<' ConcatExpression
  125                   | EqualityExpression tGTEQ ConcatExpression
  126                   | EqualityExpression tLTEQ ConcatExpression
  127                   | EqualityExpression tIS ConcatExpression

  128 ConcatExpression: AdditiveExpression
  129                 | ConcatExpression '&' AdditiveExpression

  130 AdditiveExpression: ModExpression
  131                   | AdditiveExpression '+' ModExpression
  132                   | AdditiveExpression '-' ModExpression

  133 ModExpression: IntdivExpression
  134              | ModExpression tMOD IntdivExpression

  135 IntdivExpression: MultiplicativeExpression
  136                 | IntdivExpression '\\' MultiplicativeExpression

  137 MultiplicativeExpression: ExpExpression
  138                         | MultiplicativeExpression '*' ExpExpression
  139                         | MultiplicativeExpression '/' ExpExpression

  140 ExpExpression: SignExpression
  141              | ExpExpression '^' SignExpression

  142 SignExpression: UnaryExpression
  143               | '-' SignExpression
  144               | '+' SignExpression

  145 UnaryExpression: LiteralExpression
  146                | CallExpression
  147                | tNEW Identifier

  148 CallExpression: PrimaryExpression
  149               | MemberExpression
  150               | CallExpression Arguments

  151 LiteralExpression: tTRUE
  152                  | tFALSE
  153                  | tString
  154                  | tDate
  155                  | NumericLiteralExpression
  156                  | tEMPTY
  157                  | tNULL
  158                  | tNOTHING

  159 NumericLiteralExpression: '0'
  160                         | tInt
  161                         | tDouble

  162 IntegerValue: '0'
  163             | tInt

  164 PrimaryExpression: tEXPRLBRACKET Expression ')'
  165                  | tME

  166 ClassDeclaration: tCLASS Identifier StSep ClassBody tEND tCLASS StSep

  167 ClassBody: ε
  168          | FunctionDecl
  169          | FunctionDecl StSep ClassBody
  170          | Storage MemberDeclList
  171          | Storage MemberDeclList StSep ClassBody
  172          | tDIM DimDeclList
  173          | tDIM DimDeclList StSep ClassBody
  174          | PropertyDecl
  175          | PropertyDecl StSep ClassBody

  176 PropertyDecl: Storage_opt tPROPERTY tGET Identifier ArgumentsDecl_opt StSep BodyStatements tEND tPROPERTY
  177             | Storage_opt tPROPERTY tLET Identifier '(' ArgumentDeclList ')' StSep BodyStatements tEND tPROPERTY
  178             | Storage_opt tPROPERTY tSET Identifier '(' ArgumentDeclList ')' StSep BodyStatements tEND tPROPERTY

  179 FunctionDecl: Storage_opt tSUB Identifier StSep BodyStatements tEND tSUB
  180             | Storage_opt tSUB Identifier ArgumentsDecl Nl_opt BodyStatements tEND tSUB
  181             | Storage_opt tFUNCTION Identifier StSep BodyStatements tEND tFUNCTION
  182             | Storage_opt tFUNCTION Identifier ArgumentsDecl Nl_opt BodyStatements tEND tFUNCTION

  183 Storage_opt: ε
  184            | Storage

  185 Storage: tPUBLIC tDEFAULT
  186        | tPUBLIC
  187        | tPRIVATE

  188 ArgumentsDecl_opt: ε
  189                  | ArgumentsDecl

  190 ArgumentsDecl: tEMPTYBRACKETS
  191              | '(' ArgumentDeclList ')'

  192 ArgumentDeclList: ArgumentDecl
  193                 | ArgumentDecl ',' ArgumentDeclList

  194 ArgumentDecl: Identifier EmptyBrackets_opt
  195             | tBYREF Identifier EmptyBrackets_opt
  196             | tBYVAL Identifier EmptyBrackets_opt

  197 MemberIdentifier: tIdentifier
  198                 | tERROR
  199                 | tEXPLICIT
  200                 | tSTEP

  201 Identifier: tIdentifier
  202           | tDEFAULT
  203           | tERROR
  204           | tEXPLICIT
  205           | tPROPERTY
  206           | tSTEP

  207 StSep_opt: ε
  208          | StSep

  209 Nl_opt: ε
  210       | tNL Nl_opt

  211 StSep: tNL
  212      | ':'
  213      | tNL StSep
  214      | ':' StSep


