 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/standalone/inc/wine/dlls/vbscript/compile.c b/standalone/inc/wine/dlls/vbscript/compile.c
index 8f7a9fbc6..62802db1f 100644
--- a/standalone/inc/wine/dlls/vbscript/compile.c
+++ b/standalone/inc/wine/dlls/vbscript/compile.c
@@ -2206,7 +2206,7 @@ static HRESULT check_script_collisions(compile_ctx_t *ctx, script_ctx_t *script)
     for(i = 0; i < var_cnt; i++) {
         if(lookup_script_identifier(ctx, script, vars[i].name)) {
 #ifdef __STANDALONE__
