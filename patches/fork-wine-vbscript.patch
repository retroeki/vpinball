From ec324e68ab65d20333a060c1800a65f949d13b91 Mon Sep 17 00:00:00 2001
From: "Zenolith\\zen" <johnnyzen@gmail.com>
Date: Fri, 8 May 2026 07:15:03 +0100
Subject: [PATCH] Wine vbscript: lenient out-of-bounds array reads
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Out-of-bounds READS on script-level arrays now silently return Empty
instead of aborting the script with VBSE_OUT_OF_BOUNDS. Writes still
propagate the error.

Many community tables ship with off-by-one bugs that only land on exact
bounds. Canonical example — AC-DC Premium 1.5 UpdateGIs:

    For each bulb in GI_LowPF: bulb.Intensity = LampState ((134)*3): Next

Author intent was `LampState(134) * 3` but the parens make VBScript
parse it as `LampState((134)*3)` = `LampState(402)`, while LampState is
`Dim LampState(200)`. The same line uses `*1.5` elsewhere which lands
at index 195/198/201 — the *3 case is the only one that goes far enough
out to be obviously wrong. Equivalent bugs across other tables.

Two read sites updated:
  interp.c::variant_call         — chained calls + direct array access
                                   from script (`arr(i)`, `arr(i)(j)`)
  vbdisp.c (PROPERTYGET path)    — dispatchable-array element reads

Both intercept DISP_E_BADINDEX or MAKE_VBSERROR(VBSE_OUT_OF_BOUNDS) and
substitute a non-BYREF VT_EMPTY result. Empty propagates as 0 in numeric
contexts and "" in string contexts, so the script keeps running with the
read silently zeroed.

Same "be lenient where MS appears to be" pattern used earlier this
session for to_int (whitespace BSTRs) and format_number_lcid (NLS shim
fallback). Writes through do_assign_call remain strict — a script
mutating past bounds is too suspicious to silently swallow.

Verified end-to-end: AC-DC Premium 1.5 (the original crash). Halloween,
DUCKTALES, WoZ, FORGE, AC-DC LUCI unaffected (no behavior change for
in-bounds reads).

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 standalone/inc/wine/dlls/vbscript/interp.c | 14 ++++++++++++++
 standalone/inc/wine/dlls/vbscript/vbdisp.c |  8 ++++++++
 2 files changed, 22 insertions(+)

diff --git a/standalone/inc/wine/dlls/vbscript/interp.c b/standalone/inc/wine/dlls/vbscript/interp.c
index 7be5d7873..a0dadfdc4 100644
--- a/standalone/inc/wine/dlls/vbscript/interp.c
+++ b/standalone/inc/wine/dlls/vbscript/interp.c
@@ -677,6 +677,20 @@ static HRESULT variant_call(exec_ctx_t *ctx, VARIANT *v, unsigned arg_cnt, VARIA
         V_VT(res) = VT_BYREF|VT_VARIANT;
         V_BYREF(res) = v;
     }
+#ifdef __STANDALONE__
+    else if (hres == DISP_E_BADINDEX || hres == MAKE_VBSERROR(VBSE_OUT_OF_BOUNDS)) {
+        /* [STANDALONE FIX] Lenient out-of-bounds READ — community scripts
+         * routinely have off-by-one bugs that only land on exact bounds
+         * (AC-DC Premium 1.5: `LampState ((134)*3)` evaluates to
+         * `LampState(402)` against `Dim LampState(200)`). Returning Empty
+         * lets the script keep running with the value silently treated as 0,
+         * matching how the same scripts behave on Windows in similar contexts.
+         * Writes still propagate the error via do_assign_call so we don't
+         * mask actual mutation bugs. */
+        V_VT(res) = VT_EMPTY;
+        hres = S_OK;
+    }
+#endif
 
     stack_popn(ctx, arg_cnt);
     return hres;
diff --git a/standalone/inc/wine/dlls/vbscript/vbdisp.c b/standalone/inc/wine/dlls/vbscript/vbdisp.c
index 04c8d2acf..1a840bd34 100644
--- a/standalone/inc/wine/dlls/vbscript/vbdisp.c
+++ b/standalone/inc/wine/dlls/vbscript/vbdisp.c
@@ -175,6 +175,14 @@ static HRESULT invoke_variant_prop(script_ctx_t *ctx, VARIANT *v, WORD flags, DI
 #ifdef __STANDALONE__
             if (FAILED(hres = array_access(!V_ISBYREF(v) ? V_ARRAY(v) : *V_ARRAYREF(v), dp, &v)))
             {
+                /* [STANDALONE FIX] Same lenient OOB read as interp.c::variant_call —
+                 * out-of-bounds READS return Empty rather than aborting the script.
+                 * See variant_call in interp.c for full rationale. Writes (handled in
+                 * the PROPERTYPUT path below) still propagate errors. */
+                if (hres == DISP_E_BADINDEX || hres == MAKE_VBSERROR(VBSE_OUT_OF_BOUNDS)) {
+                    V_VT(res) = VT_EMPTY;
+                    return S_OK;
+                }
 #else
             if(FAILED(hres = get_array_from_variant(v, &array)))
                 return hres;
