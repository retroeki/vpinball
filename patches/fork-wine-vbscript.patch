+/* Simple wide string helpers for recursion tracking */
+static inline int wstr_cmp(const WCHAR *s1, const WCHAR *s2)
+{
+    while(*s1 && *s1 == *s2) { s1++; s2++; }
+    return *s1 - *s2;
+}
+
+static inline void wstr_cpy(WCHAR *dst, const WCHAR *src, int max_len)
+{
+    int i;
+    for(i = 0; i < max_len - 1 && src[i]; i++)
+        dst[i] = src[i];
+    dst[i] = 0;
+}
