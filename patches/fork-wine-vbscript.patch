From f3639b83513403fcb25417cbe6297a9ca6f95235 Mon Sep 17 00:00:00 2001
From: "Zenolith\\zen" <johnnyzen@gmail.com>
Date: Fri, 24 Apr 2026 19:21:04 +0100
Subject: [PATCH] Wine VBScript diagnostics, OnScriptError filter, post-audit
 patcher pass
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- standalone/inc/wine/dlls/vbscript/vbscript.c: log every
  report_script_error call under a new VBScriptRuntime logcat tag,
  including scode, wCode, line/char/loc, start_line, source, description,
  and the first ~160 chars of the erroring code block (newlines shown as
  ¶). Combined with the pre-existing VBScriptCompile tag in compile.c,
  this is the ground-truth oracle for whether Wine rejected a script and
  what it threw when running — replaces guessing with hard evidence.
- src/ui/codeview.cpp: CodeViewer::OnScriptError now filters out the
  inner-Execute OERN noise pattern (scode=E_FAIL, line=1, char=0, empty
  description). Wine's Execute statement runs its string argument in a
  nested script context; an outer On Error Resume Next does not propagate
  into it, so benign init-loop errors like Execute "Set Lights(i)=Li"
  for unresolved Li always notify the host. Previously the host set
  m_scriptError=true on every notification, causing Player::FinishFrame
  to kill the player ~2s later even when the script was fine.
  Fixes Medieval Madness Bigus MOD 3.0 and any other table with
  OERN-guarded Execute init loops.
- src/ui/simplescriptpatcher.{cpp,h}: full post-audit dispatcher
  rewrite. 13 upstream-corroborated rules enabled; ~18 low/medium/dead-
  confidence rules explicitly commented out with evidence citations.
  Re-enables PatchControllerPause (Knight Rider line-13 runtime E_FAIL
  on Controller.Pause = True) and PatchDuplicateVpmInit (Back to the
  Future flipper callback corruption). Adds and then disables
  PatchReversedRelationalOp, which today's empirical test on MM 3.0
  disproved as load-bearing. Rationale and live state captured in
  C:/Android/com.retroeki.pinball/crash_investigations/vpx_standalone_scripts_audit.md §7.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 standalone/inc/wine/dlls/vbscript/vbscript.c | 47 ++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/standalone/inc/wine/dlls/vbscript/vbscript.c b/standalone/inc/wine/dlls/vbscript/vbscript.c
index 2975f26d7..6dc8c9dcf 100644
--- a/standalone/inc/wine/dlls/vbscript/vbscript.c
+++ b/standalone/inc/wine/dlls/vbscript/vbscript.c
@@ -26,6 +26,14 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(vbscript);
 
+#ifdef __ANDROID__
+#include <android/log.h>
+#define VBS_ERR_LOG(...) __android_log_print(ANDROID_LOG_ERROR, "VBScriptRuntime", __VA_ARGS__)
+#else
+#include <stdio.h>
+#define VBS_ERR_LOG(...) fprintf(stderr, __VA_ARGS__)
+#endif
+
 #ifdef _WIN64
 
 #define CTXARG_T DWORDLONG
@@ -584,6 +592,45 @@ HRESULT report_script_error(script_ctx_t *ctx, const vbscode_t *code, unsigned l
     }
     error->character = code->source + loc - nl;
 
+    /* Instrumentation: log the raw EXCEPINFO Wine populated BEFORE it hands it
+     * off to the host's OnScriptError, plus the first 160 chars of the code
+     * block that errored (so we can identify WHICH script snippet is
+     * failing even when the host reports line=0/loc=0). */
+    {
+        char src[256] = {0}, desc[512] = {0}, snippet[200] = {0};
+        if (error->ei.bstrSource) {
+            int n = WideCharToMultiByte(CP_UTF8, 0, error->ei.bstrSource, -1,
+                                        src, sizeof(src) - 1, NULL, NULL);
+            if (n <= 0) src[0] = '\0';
+        }
+        if (error->ei.bstrDescription) {
+            int n = WideCharToMultiByte(CP_UTF8, 0, error->ei.bstrDescription, -1,
+                                        desc, sizeof(desc) - 1, NULL, NULL);
+            if (n <= 0) desc[0] = '\0';
+        }
+        if (code && code->source) {
+            /* Clamp to 160 wchars for WC→UTF-8 round-trip. Replace newlines with
+             * a visible marker so everything stays on one log line. */
+            WCHAR tmp[161];
+            unsigned i;
+            for (i = 0; i < 160 && code->source[i]; i++) {
+                tmp[i] = (code->source[i] == '\n' || code->source[i] == '\r')
+                         ? (WCHAR)0x00B6 /* ¶ */
+                         : code->source[i];
+            }
+            tmp[i] = 0;
+            int n = WideCharToMultiByte(CP_UTF8, 0, tmp, -1,
+                                        snippet, sizeof(snippet) - 1, NULL, NULL);
+            if (n <= 0) snippet[0] = '\0';
+        }
+        VBS_ERR_LOG("report_script_error: scode=0x%08lx wCode=0x%04x line=%u char=%u loc=%u start_line=%u source=\"%s\" description=\"%s\" snippet=\"%s\"",
+                    (unsigned long)error->ei.scode, (unsigned)error->ei.wCode,
+                    (unsigned)error->line, (unsigned)error->character,
+                    (unsigned)loc,
+                    code ? (unsigned)code->start_line : 0u,
+                    src, desc, snippet);
+    }
+
     hres = IActiveScriptSite_OnScriptError(ctx->site, &error->IActiveScriptError_iface);
     IActiveScriptError_Release(&error->IActiveScriptError_iface);
     return hres == S_OK ? SCRIPT_E_REPORTED : result;
-- 
