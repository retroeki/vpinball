From 339584c008a79e18c65ef0d0d0445af1af5d25ff Mon Sep 17 00:00:00 2001
From: "Zenolith\\zen" <johnnyzen@gmail.com>
Date: Fri, 8 May 2026 08:22:08 +0100
Subject: [PATCH] Wine vbscript: allow Sub + Property of same name in a class
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Wine 10.x silently accepted classes with both `Sub Foo(...)` and
`Property Let Foo(...)` (or any Sub/Function paired with a Property
accessor) because they map to different VBDISP slots. The 11.8 merge
tightened parser.y::add_class_function to reject any Sub/Function
appearing alongside a same-named member — but that's stricter than
necessary. The real conflict is two members fighting for the same
dispatch slot, not just any name overlap.

Slot mapping (per compile.c::compile_func):
  FUNC_FUNCTION / FUNC_SUB / FUNC_PROPGET  → VBDISP_CALLGET
  FUNC_PROPLET                              → VBDISP_LET
  FUNC_PROPSET                              → VBDISP_SET

Real conflicts:
  Sub Foo + Sub Foo                  same slot → reject
  Sub Foo + Function Foo             same slot → reject
  Sub Foo + Property Get Foo         same slot → reject
  Property Let Foo + Property Let    same slot → reject

Allowed (different slots, dispatcher routes by wFlags):
  Sub Foo + Property Let Foo         CALLGET + LET
  Sub Foo + Property Set Foo         CALLGET + SET
  Property Get Foo + Property Let    CALLGET + LET (already worked)

Replaces the early Sub/Function early-out with a slot-equality check
that walks the next_prop_func chain. Also skips check_property_args
when one side is Sub/Function — that helper's arg-count rule is for
PropGet-vs-PropLet/Set semantics, irrelevant for Sub/Function combos.

The Lampz framework (used by Elvis MOD 2.0 and others) legitimately
defines Sub MassAssign(a,b) and Property Let MassAssign(a,b) in the
same class. Different invocation syntax dispatches to each:
  obj.MassAssign x, y       -> Sub call (DISPATCH_METHOD)
  obj.MassAssign(x) = y     -> Property Let (DISPATCH_PROPERTYPUT)

Guarded with __STANDALONE__; non-standalone keeps upstream's strict
behavior. parser.tab.c is regenerated from parser.y by bison.

Verified: Elvis MOD 2.0 now compiles past line 4931 and reaches
gameplay. No regressions on previously-tested tables.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 standalone/inc/wine/dlls/vbscript/parser.y | 47 ++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/standalone/inc/wine/dlls/vbscript/parser.y b/standalone/inc/wine/dlls/vbscript/parser.y
index ec67cde22..562c41b34 100644
--- a/standalone/inc/wine/dlls/vbscript/parser.y
+++ b/standalone/inc/wine/dlls/vbscript/parser.y
@@ -1309,6 +1309,52 @@ static class_decl_t *add_class_function(parser_ctx_t *ctx, class_decl_t *class_d
             return NULL;
         }
         if(!wcsicmp(iter->name, decl->name)) {
+#ifdef __STANDALONE__
+            /* Wine 10.x silently accepted classes with both `Sub Foo` and
+             * `Property Let Foo` (or similar Sub/Function + Property combos)
+             * because they map to different VBDISP slots: Sub/Function/PropGet
+             * → VBDISP_CALLGET, PropLet → VBDISP_LET, PropSet → VBDISP_SET.
+             * Wine 11.8's parser tightened the check to reject any Sub/Function
+             * appearing alongside any same-named member, but that's stricter
+             * than necessary — same-slot conflicts are the real error. The
+             * Lampz/Elvis MOD framework legitimately defines both
+             * `Sub MassAssign(a,b)` and `Property Let MassAssign(a,b)` in one
+             * class; reject only when the new decl collides on the *same*
+             * dispatch slot as something already chained. */
+            #define FUNCDECL_SLOT(t) \
+                ((t) == FUNC_PROPLET ? 1 : ((t) == FUNC_PROPSET ? 2 : 0))
+
+            while(1) {
+                if(FUNCDECL_SLOT(iter->type) == FUNCDECL_SLOT(decl->type)) {
+                    WARN("%s::%s redefined (same dispatch slot)\n",
+                        debugstr_w(class_decl->name), debugstr_w(decl->name));
+                    ctx->error_loc = iter->name_loc;
+                    ctx->hres = MAKE_VBSERROR(VBSE_NAME_REDEFINED);
+                    return NULL;
+                }
+                if(!iter->next_prop_func)
+                    break;
+                iter = iter->next_prop_func;
+            }
+
+            #undef FUNCDECL_SLOT
+
+            /* check_property_args is meaningful for PropGet vs PropLet/Set
+             * (arg count differs by 1). For Sub/Function + PropLet/Set both
+             * sides take the same arg count, which is the default-return
+             * branch. Skip the call when one side is Sub/Function — its
+             * arg-count semantics are unrelated to property arg-count rules. */
+            if(iter->type != FUNC_SUB && iter->type != FUNC_FUNCTION
+                    && decl->type != FUNC_SUB && decl->type != FUNC_FUNCTION) {
+                if(!check_property_args(iter, decl)) {
+                    ctx->error_loc = decl->loc;
+                    ctx->hres = MAKE_VBSERROR(VBSE_PROPERTY_ARG_COUNT_MISMATCH);
+                    return NULL;
+                }
+            }
+            iter->next_prop_func = decl;
+            return class_decl;
+#else
             if(decl->type == FUNC_SUB || decl->type == FUNC_FUNCTION
                     || iter->type == FUNC_SUB || iter->type == FUNC_FUNCTION) {
                 WARN("%s::%s redefined\n", debugstr_w(class_decl->name), debugstr_w(decl->name));
@@ -1336,6 +1382,7 @@ static class_decl_t *add_class_function(parser_ctx_t *ctx, class_decl_t *class_d
             }
             iter->next_prop_func = decl;
             return class_decl;
+#endif
         }
     }
 
